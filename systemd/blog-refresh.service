[Unit]
Description=Blog RSS Source Refresh
Documentation=https://github.com/your-org/ai-blog
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=blog
Group=blog
WorkingDirectory=/opt/blog-backend
EnvironmentFile=/etc/blog-backend/env
ExecStart=/opt/blog-backend/.venv/bin/python -m blog.refresh_sources
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
TimeoutStartSec=900
Restart=no

[Install]
WantedBy=multi-user.target
